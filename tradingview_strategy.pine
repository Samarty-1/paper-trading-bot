//@version=5
strategy("EMA Trend + RSI + Vol-Targeted Sizing", overlay=true,
     initial_capital=10000,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=2,
     margin_long=50)  // allows up to 2x leverage headroom

// --- Inputs ---
fastLen      = input.int(20, "Fast EMA Length")
slowLen      = input.int(50, "Slow EMA Length")
rsiLen       = input.int(14, "RSI Length")
rsiLongMax   = input.int(70, "Skip Entry if RSI Above")
atrLen       = input.int(14, "ATR Length")
atrStopMult  = input.float(2.0, "Trailing Stop (x ATR)")
riskPerTrade = input.float(0.015, "Risk per Trade (% of equity)", step=0.005)
maxLeverage  = input.float(2.0, "Max Leverage Cap")
useAdxFilter = input.bool(false, "Use ADX Regime Filter (tested: hurts results, off by default)")
adxLen       = input.int(14, "ADX Length")
adxMin       = input.int(20, "Min ADX to Trade")
startDate    = input.time(timestamp("2018-01-01"), "Backtest Start Date")

// --- Indicators ---
fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)
[diplus, diminus, adxVal] = ta.dmi(adxLen, adxLen)

plot(fastEMA, "Fast EMA", color=color.blue)
plot(slowEMA, "Slow EMA", color=color.orange)

inDateRange = time >= startDate
trending    = not useAdxFilter or adxVal > adxMin

var float trailStop = na

longCond = ta.crossover(fastEMA, slowEMA) and rsiVal < rsiLongMax and trending and inDateRange

// --- Entry: size by risking a fixed % of equity against the ATR stop distance ---
if strategy.position_size == 0
    stopDistance = atrVal * atrStopMult
    if longCond and stopDistance > 0
        dollarRisk = strategy.equity * riskPerTrade
        qtyByRisk  = math.floor(dollarRisk / stopDistance)
        maxQty     = math.floor(strategy.equity * maxLeverage / close)
        qty        = math.min(qtyByRisk, maxQty)
        if qty > 0
            trailStop := close - stopDistance
            strategy.entry("Long", strategy.long, qty=qty)

// --- Exit: ATR trailing stop (ratchets up only) or trend reversal ---
if strategy.position_size > 0
    newStop = close - atrVal * atrStopMult
    trailStop := math.max(trailStop, newStop)
    strategy.exit("Long Exit", "Long", stop=trailStop)
    if ta.crossunder(fastEMA, slowEMA)
        strategy.close("Long")

plot(strategy.position_size > 0 ? trailStop : na, "Trailing Stop", color=color.red, style=plot.style_circles)
